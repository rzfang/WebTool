<page-url>
  <page-layout>
    <div class='input-box'>
      <label>
        <input type='checkbox' onchange={EqualToggle}/>
        hide equal rows
      </label>
      <ul>
        <li>
          <input type='text' oninput={UrlsParseAndCompare}/>
        </li>
        <li>
          <input type='text' oninput={UrlsParseAndCompare}/>
        </li>
      </ul>
    </div>
    <div class={'output-box ' + (state.hideEqual ? 'hide-equal' : '')}>
      <div each={key in propertyKeys} class={state.equalKeys.includes(key) ? 'is-equal' : ''}>
        <dl>
          <dt>{key}</dt>
          <dd each={url in state.urls}>{url[key] || ' '}</dd>
        </dl>
      </div>
      <h4>parsed searchParams</h4>
      <div each={key in state.searchParamKeys} class={state.equalKeys.includes(key) ? 'is-equal' : ''}>
        <dl>
          <dt>{key}</dt>
          <dd each={url in state.urls}>{url && url.searchParamsObject && url.searchParamsObject[key] || ' '}</dd>
        </dl>
      </div>
    </div>
  </page-layout>
  <style>
    :host {
      .input-box {
        >label { cursor: pointer; }

        >ul {
          margin: 0; padding: 0; list-style: none;

          input[type=text] { width: 100%; }
        }
      }

      .output-box {
        &.hide-equal .is-equal {
          display: none;
        }

        >div {
          &.is-equal { color: #808080; }

          &:hover {
            background-color: #80808080;
          }

          >dl {
            display: grid;
            gap: 10px;
            grid-template-columns: 1fr 1fr;
            grid-template-areas: 't t' 'l r';

            >dt {
              grid-area: t;
              font-weight: bold;
            }

            >dd {
              margin: 0;
              word-break: break-all;

              &:first-child {
                grid-area: l;
              }

              &:last-child {
                grid-area: r;
              }
            }
          }
        }

        >h4 {
          text-align: center;
        }
      }
    }
  </style>
  <script>
    import pageLayout from './page-layout.riot';

    export default {
      components: { pageLayout },

      propertyKeys: [
        'origin',
        'username',
        'password',
        'protocol',
        'host',
        'hostname',
        'port',
        'pathname',
        'hash',
      ], // property keys.

      state: {
        equalKeys: [],
        hideEqual: false,
        searchParamKeys: [],
        urls: [],
      },

      EqualToggle (event) {
        this.update({ hideEqual: event.target.checked });
      },

      // reference - https://developer.mozilla.org/en-US/docs/Web/API/URL_API#examples
      SearchParamsToObject (searchParams) {
        searchParams.sort();

        const keys = searchParams.keys();
        const result = {};

        for (const key of keys) {
          result[key] = searchParams.get(key);
        }

        return result;
      },

      UrlsParseAndCompare () {
        const resultUrls = [ {}, {} ];
        const urls = this.$$('input[type=text]').map(one => one.value ? new URL(one.value) : '');
        let paramKeys = [];

        urls.forEach((url, index) => {
          if (!url) { return; }

          this.propertyKeys.forEach(key => { resultUrls[index][key] = urls[index][key]; });

          resultUrls[index].searchParamsObject = this.SearchParamsToObject(urls[index].searchParams);
          paramKeys = [ ...paramKeys, ...Object.keys(resultUrls[index].searchParamsObject) ];
        });

        paramKeys = paramKeys.filter((value, index, array) => array.indexOf(value) === index);

        const equalKeys = []; // equal keys.

        this.propertyKeys.forEach(key => {
          let isEqual = true;

          for (let i = 1; i < resultUrls.length; i++) {
            isEqual &= (resultUrls[i][key] === resultUrls[i - 1][key]);
          }

          if (isEqual) { equalKeys.push(key); }
        });

        paramKeys.forEach(key => {
          let isEqual = true;

          for (let i = 1; i < resultUrls.length; i++) {
            if (!resultUrls[i].searchParamsObject || !resultUrls[i - 1].searchParamsObject) {
              isEqual = false;

              break;
            }

            isEqual &= (resultUrls[i].searchParamsObject[key] === resultUrls[i - 1].searchParamsObject[key]);
          }

          if (isEqual) { equalKeys.push(key); }
        })

        this.update({ equalKeys: equalKeys, searchParamKeys: paramKeys, urls: resultUrls });
      }
    }
  </script>
</page-url>