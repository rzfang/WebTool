<page-keycode>
  <page-layout>
    <div class='key-in-box'>
      <b>Key in</b>
      <input type='text' id='Keyin' onkeydown={recordKey} onkeypress={recordKey} onkeyup={recordKey} />
    </div>
    <div class='option-panel'>
      <b>Record with</b>
      <label>
        <input type='checkbox' value='keyDown' checked={state.recordOn.keyDown} onchange={toggleRecord} />
        KeyDown
      </label>
      <label>
        <input type='checkbox' value='keyPress' checked={state.recordOn.keyPress} onchange={toggleRecord} />
        KeyPress
      </label>
      <label>
        <input type='checkbox' value='keyUp' checked={state.recordOn.keyUp} onchange={toggleRecord} />
        KeyUp
      </label>
    </div>
    <div class='record-box'>
      <b>Records</b>
      <button onclick={clearRecords}>Clear</button>
      <table>
        <thead>
          <th>type</th>
          <th>code</th>
          <th>key</th>
          <th>keyCode</th>
        </thead>
        <tbody>
          <tr each={one in state.records}>
            <td>{one.type}</td>
            <td>{one.code}</td>
            <td>{one.key}</td>
            <td>{one.keyCode}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </page-layout>
  <style>
    :host {
      b {
        margin-right: 5px;
      }

      .key-in-box,
      .option-panel,
      .record-box {
        margin-bottom: 20px;
        border-left: 1px solid var(--color-border);
        border-radius: 0;
        padding-left: 10px;
      }

      .option-panel {
        >label {
          margin-right: 5px;
          border: 1px solid var(--color-border);
          border-radius: 5px;
          padding: 5px;
          cursor: pointer;

          >* {
            vertical-align: center;
          }
        }
      }

      .record-box {
        >table {
          border-spacing: 0;

          td {
            border-radius: 0;
            padding: 5px;
          }

          >tbody>tr:hover>td {
            background-color: #808080;
          }
        }
      }
    }
  </style>
  <script>
    import pageLayout from './page-layout.riot';

    export default {
      components: { pageLayout },

      state: {
        records: [],
        recordOn: {
          keyDown: true,
          keyPress: true,
          keyUp: true,
        },
      },

      getIsRecordingByEventType (type) {
        switch (type) {
          case 'keydown':
            return this.state.recordOn.keyDown;

          case 'keypress':
            return this.state.recordOn.keyPress;

          case 'keyup':
            return this.state.recordOn.keyUp;
        }

        return false;
      },

      recordKey (event) {
        if (!this.getIsRecordingByEventType(event.type)) {
          return;
        }

        this.update({
          records: [
            {
              code: event.code,
              key: event.key,
              type: event.type,
              keyCode: event.keyCode && `${event.keyCode} (0x${event.keyCode.toString(16)})` || '',
            },
            ...this.state.records,
          ],
        });
      },

      clearRecords () {
        this.update({ records: [] });
      },

      toggleRecord (event) {
        const recordOn = this.state.recordOn;
        const { checked, value } = event.target;

        switch (value) {
          case 'keyDown':
            recordOn.keyDown = checked;

            break;

          case 'keyPress':
            recordOn.keyPress = checked;

            break;

          case 'keyUp':
            recordOn.keyUp = checked;

            break;
        }
      },
    }
  </script>
</page-keycode>
