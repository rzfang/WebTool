<page-window>
  <page-layout>
    <table>
      <thead>
        <tr>
          <th>Manual</th>
          <th>Name</th>
          <th>Value</th>
          <th>Explain</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><input type='checkbox'/></td>
          <td>height</td>
          <td><input type='number' name='height' value='100'/></td>
          <td> Min. value is 100.<br/>The height of the window.</td>
        </tr>
        <tr>
          <td><input type='checkbox'/></td>
          <td>left</td>
          <td><input type='number' name='left' value='0' /></td>
          <td>The left position of the window.</td>
        </tr>
        <tr>
          <td><input type='checkbox'/></td>
          <td>noopener</td>
          <td>yes: <input type='radio' name='noopener' checked='true'/> no: <input type='radio' name='noopener'/></td>
          <td>Prevents the new window from accessing the opening window via window.opener.</td>
        </tr>
        <tr>
          <td><input type='checkbox'/></td>
          <td>popup</td>
          <td>yes: <input type='radio' name='popup' checked='true'/> no: <input type='radio' name='popup'/></td>
          <td>Default is yes.<br/>pop up a simple window.</td>
        </tr>
        <tr>
          <td><input type='checkbox'/></td>
          <td>top</td>
          <td><input type='number' name='top' value='0'/></td>
          <td>The top position of the window.</td>
        </tr>
        <tr>
          <td><input type='checkbox'/></td>
          <td>width</td>
          <td><input type='number' name='width' value='100'/></td>
          <td>Min. value is 100.<br/>The width of the window.</td>
        </tr>
      </tbody>
    </table>
    <br/><hr/><br/>
    <div>
      URL: <input type='text'/>
      Name: <input type='text' list='name-option' />
      <datalist id='name-option'>
        <option value='_blank'>_blank - open a new window. Default.</option>
        <option value='_parent'>_parent - open to the parent frame.</option>
        <option value='_self'>_self - replaces the current frame</option>
        <option value='_top'>_top - replaces ancient frame.</option>
      </datalist>
      <input type='button' value='Make Script' onclick={scriptMake}/>
      <input type='button' value='Open Test' onclick={test}/><br/>
      <textarea id='ScptBx' cols='80'></textarea>
    </div>
    <div>
      Reference:
      <a href='http://www.w3schools.com/jsref/met_win_open.asp'>W3C School - Window open() Method</a> |
    </div>
  </page-layout>
  <style>
    :host {
      table td { max-width: 500px; margin: 0px; padding: 5px; border: 1px solid var(--color-border); }
    }
  </style>
  <script>
    import pageLayout from './page-layout.riot';

    export default {
      components: { pageLayout },

      /* Parse each Option to string.
        < string of option. */
      optionParse () {
        const options = this.$$('tbody>tr')
          .map(one => {
            const [ checkedElement, valueElemet ] = one.querySelectorAll('td>input:first-child');

            if (!checkedElement.checked) { return ''; }

            const type = valueElemet.type;

            if (type === 'radio') {
              return valueElemet.name + '=' + (valueElemet.checked ? 'yes' : 'no');
            }

            return valueElemet.name + '=' + parseInt(valueElemet.value, 10);
          })
          .filter(one => one !== '');

        return options.join(', ');
      },

      scriptMake () {
        const [ url, name ] = this.$$('div>input[type=text]').map(one => one.value);
        const info = this.optionParse();

        this.$('textarea').value = `window.open('${url}', '${name}', '${info}')`;
      },

      test () {
        const [ url, name ] = this.$$('div>input[type=text]').map(one => one.value);
        const info = this.optionParse();

        window.open(url, name, info);
      }
    }
  </script>
</page-window>